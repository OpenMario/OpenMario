{
   "name": "@openmario",
   "description": "Openmario monorepo",
   "version": "1.0.0",
   "repository": {
      "type": "git",
      "url": "git+ssh://git@github.com/MagadhTech/MDS-Banking.git"
   },
   "bugs": {
      "url": "https://github.com/MagadhTech/MDS-Banking/issues"
   },
   "workspaces": ["apps/*", "packages/*", "crons/*"],
   "packageManager": "bun@1.4",
   "private": "true",
   "scripts": {
      "dev": "bun run --env-file=.env turbo run dev",
      "dev:setup": "bash scripts/dev-setup.sh",
      "dev:up": "docker compose -f docker-compose.dev.yml --env-file .env up -d --wait",
      "dev:down": "docker compose -f docker-compose.dev.yml --env-file .env down",
      "dev:reset": "docker compose -f docker-compose.dev.yml --env-file .env down -v",
      "client:build": "bun run --filter '@openmario/client' build",
      "client:dev": "bun run --filter '@openmario/client' dev",
      "client-new:build": "bun run --filter '@openmario/client-new' build",
      "client-new:dev": "bun run --filter '@openmario/client-new' dev",
      "server:build": "bun run --filter '@openmario/server' build",
      "server:start": "bun run --filter '@openmario/server' start",
      "mcp:dev": "bun run --filter '@openmario/mcp' dev",
      "mcp:build": "bun run --filter '@openmario/mcp' build",
      "mcp:start": "bun run --filter '@openmario/mcp' start",
      "meili:configure-embedders": "bun run --env-file=.env packages/meilisearch/search_index/configure-embedders.ts",
      "build": "bun x turbo run build --ui stream",
      "kill": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true; lsof -ti:4000 | xargs kill -9 2>/dev/null || true; lsof -ti:5173 | xargs kill -9 2>/dev/null || true; lsof -ti:8080 | xargs kill -9 2>/dev/null || true",
      "clean": "rm bun.lock && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
      "test": "turbo run test",
      "lint": "turbo run lint",
      "fmt": "bunx biome format --write .",
      "format": "bunx biome format --write .",
      "type-check": "turbo run type-check",
      "db:generate": "bun run --env-file=.env drizzle-kit generate",
      "db:migrate": "bun run --env-file=.env drizzle-kit migrate",
      "db:push": "bun run --env-file=.env drizzle-kit push",
      "db:studio": "bun run --env-file=.env drizzle-kit studio",
      "meili:seed": "bun run --filter @openmario/meilisearch seed",
      "meili:seed:courses": "bun run --filter @openmario/meilisearch seed:courses",
      "meili:seed:submissions": "bun run --filter @openmario/meilisearch seed:submissions"
   },
   "devDependencies": {
      "@types/bun": "^1.3.5",
      "@biomejs/biome": "2.3.10",
      "drizzle-kit": "^0.31.10",
      "typescript": "^5.9.3",
      "turbo": "^2.7.2"
   },
   "dependencies": {
      "@dotenvx/dotenvx": "^1.52.0",
      "@flydotio/dockerfile": "^0.7.10",
      "@react-three/drei": "^10.7.7",
      "@react-three/fiber": "^9.5.0",
      "csv-parse": "^6.1.0",
      "drizzle-orm": "^0.45.2"
   }
}
