# Local development defaults. `bun run dev:setup` copies this to .env and
# fills in the two generated secrets. Never put production credentials here.

# --- Server ---
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openmario
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=__GENERATED__
BETTER_AUTH_SECRET=__GENERATED__
BETTER_AUTH_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CLIENT_PUBLIC_BASE_URL=http://localhost:5173

# --- MCP server (optional) ---
MCP_PORT=3100
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
OPENAI_API_KEY=

# --- Client (Vite) ---
VITE_APP_TITLE=OpenMario (dev)
VITE_MEILI_HOST=http://localhost:7700
VITE_SERVER_URL=http://localhost:3000/
VITE_DISCORD_WEBHOOK=

# --- docker-compose.dev.yml (only change if the ports clash) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=openmario
POSTGRES_PORT=5432
MEILI_PORT=7700
